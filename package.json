{
  "name": "code-executor",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types server.ts",
    "dev": "nodemon --config config/nodemon.json --exec \"node --experimental-strip-types\" server.ts",
    "test": "npm run test:unit && npm run test:redis && npm run test:api",
    "test:unit": "node --experimental-strip-types --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:redis": "node --experimental-strip-types --test --test-concurrency=1 tests/redis/*.test.ts",
    "test:api": "node --experimental-strip-types --test --test-concurrency=1 tests/api/*.test.ts",
    "test:integration": "RUN_DOCKER_TESTS=1 node --experimental-strip-types --test --test-force-exit --test-concurrency=1 tests/docker/*.test.ts",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-lines=70 --test-concurrency=1 tests/unit/*.test.ts tests/redis/*.test.ts tests/api/*.test.ts",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "seed:admin": "node --experimental-strip-types scripts/seed-admin.ts",
    "diagnose": "node --experimental-strip-types scripts/diagnose.ts",
    "load:test": "k6 run scripts/load-test.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3"
  }
}
